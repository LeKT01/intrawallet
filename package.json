{
  "name": "portefeuille-local",
  "version": "1.0.1-beta.2",
  "description": "Suivi local d’un portefeuille personnel",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test",
    "test:browser": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "check": "tsc --noEmit",
    "android:sync": "npm run build && cap sync android",
    "market:relay": "node server/marketRelay.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.4.3",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/share": "8.0.1",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "private": true
}
